# Local values for Postgres on :5433. Copy to .env and export, or set in your shell.
AETHER_DATABASE_URL=postgresql://aether_app:aether_app@127.0.0.1:5433/aether_dev
AETHER_MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aether_dev
AETHER_WORKER_DATABASE_URL=postgresql://aether_worker:aether_worker@127.0.0.1:5433/aether_dev
# Provider's verified sender, used until a shop verifies its own domain (as the partner's EMAIL_FROM).
AETHER_EMAIL_FALLBACK_FROM=shops@provider.example
AETHER_LISTEN=127.0.0.1:2384
AETHER_LOG_FORMAT=pretty
# Keys partner services send as the bearer on admin routes; comma-separated to rotate.
AETHER_PARTNER_KEYS=dev-partner-key-not-for-production
# Optional: Cloudflare Images for product media (uploads answer 503 without it)
# AETHER_CLOUDFLARE_IMAGES_ACCOUNT_ID=
# AETHER_CLOUDFLARE_IMAGES_API_TOKEN=
# AETHER_CLOUDFLARE_IMAGES_DELIVERY_URL=https://imagedelivery.net/<account hash>
# The account's delivery variant images are served at
# AETHER_CLOUDFLARE_IMAGES_VARIANT=public
# Shop emails: log (default) | smtp (Mailpit on 127.0.0.1:1025) | ses (AWS_REGION + standard credentials).
AETHER_EMAIL_TRANSPORT=log
# Optional: Stripe Connect (payment endpoints answer 503 without it). Use test-mode keys in
# development and staging, where the 4242 4242 4242 4242 test card pays. The webhook secret is
# the Connect endpoint's (for local runs: `stripe listen --forward-connect-to localhost:2384/v1/webhooks/payments/stripe`).
# AETHER_STRIPE_SECRET_KEY=sk_test_...
# AETHER_STRIPE_PUBLISHABLE_KEY=pk_test_...
# AETHER_STRIPE_WEBHOOK_SECRET=whsec_...
# Tests: each test clones a template database on this server (needs the roles from db/bootstrap.sql).
AETHER_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
